<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Side-by-side manifest for castaway.exe on Windows, staged next to the binary by
  nix/windows.nix. Taken from CEF's own cefsimple sample
  (%CEF_ROOT%/tests/cefsimple/win/compatibility.manifest, as bundled by the `cef` crate) —
  a CEF host is expected to declare these.

  An external `<exe>.manifest` is only honoured because we embed none in the image; if a
  manifest ever gets embedded via llvm-rc, this file becomes dead weight and the contents
  have to move into the resource script instead.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows Vista -->
      <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}"/>
      <!-- Windows 7 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
      <!-- Windows 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <!-- Windows 10 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <!-- Required for XAML islands in-process, which CEF uses for media scenarios.
           Corresponds to the Windows 10 May 2019 Update. -->
      <maxversiontested Id="10.0.18362.0"/>
    </application>
  </compatibility>

  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="Win32" name="Microsoft.Windows.Common-Controls" version="6.0.0.0" processorArchitecture="*" publicKeyToken="6595b64144ccf1df" language="*"></assemblyIdentity>
    </dependentAssembly>
  </dependency>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <!-- A kiosk receiver has no business asking for elevation. -->
        <requestedExecutionLevel level="asInvoker" />
      </requestedPrivileges>
    </security>
  </trustInfo>

</assembly>
