# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# Nix
result
result-*

# direnv
.direnv/

# Coverage reports
lcov.info
*.profraw
*.profdata
coverage/
htmlcov/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Local environment overrides (if any)
# `.env` holds real Spotify account credentials for the test harness — never commit it.
# `.env.example` documents the keys and IS committed.
.env
.env.*
!.env.example
.envrc.local

# The relative directory `castaway-paths` falls back to when the environment names no
# home at all (a bare `cargo run` under a scrubbed env).
.castaway/

# The working-directory config a `cargo run` picks up. Local by definition: deployments
# name their config with `$CASTAWAY_CONFIG` (the NixOS module generates one), so anything
# here is somebody's dev box and not the panel on the wall.
/castaway.toml

/TODO.md

# Python bytecode. `nix/*.py` are carve scripts run from the Nix build and from the
# RE shell; a stray `__pycache__` from the latter got committed once (5638ce7).
__pycache__/
*.pyc
