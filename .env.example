# Credentials for the Spotify *test harness* — never for the receiver itself.
#
# The receiver deliberately holds no account: a phone on the LAN hands it credentials
# over zeroconf `addUser` (see docs/DECISION-LOG.md D31). These values exist only so
# `spotify-selfplay` can act as a scripted controller — the robot phone that proves the
# control and queueing surface works without a human tapping anything.
#
# Copy to `.env` and fill in. `.env` is gitignored; `.env.example` is not.

# Account used by the harness. Needs Spotify Premium — Connect targets are Premium-only
# for non-eSDK devices.
SPOTIFY_USERNAME=
SPOTIFY_PASSWORD=

# OAuth client used to mint controller tokens. Defaults to Spotify's own desktop client
# id, which is what librespot uses and what the PKCE loopback flow accepts without
# registering an app.
SPOTIFY_CLIENT_ID=65b708073fc0480ea92a077233ca87bd

# Cached after the first interactive/headless login so later runs skip the browser.
# `spotify-selfplay login` writes this back into `.env`.
SPOTIFY_REFRESH_TOKEN=
