# Credentials for the Spotify *test harness* — never for the receiver itself.
#
# The receiver deliberately holds no account: a phone on the LAN hands it credentials
# over zeroconf `addUser` (see docs/DECISION-LOG.md D30). These values exist only so the
# selfplay harness can act as a scripted controller — the robot phone that proves the
# control and queueing surface works without a human tapping anything:
#
#   cargo run -p proto-spotify --example selfplay -- http://<receiver>:8080
#
# Copy to `.env.local` and fill in. The harness reads `.env.local` first, then `.env`;
# both are gitignored, `.env.example` is not.

# The account to authorise with. Needs Spotify Premium — Connect targets are Premium-only
# for non-eSDK devices.
#
# Note these are NOT read by anything: Spotify removed password auth, so there is no API
# to hand them to. They are here so whoever does the one-time browser authorisation below
# knows which account to use, and so the harness account is recorded somewhere other than
# a chat log. The token minted from that login is what actually gets used.
SPOTIFY_USERNAME=
SPOTIFY_PASSWORD=

# OAuth client used to mint controller tokens. Defaults to Spotify's own desktop client
# id, which is what librespot uses and what the PKCE loopback flow accepts without
# registering an app.
SPOTIFY_CLIENT_ID=65b708073fc0480ea92a077233ca87bd

# Cached after the first login so later runs need no browser at all.
#
# Spotify has no device-code flow, so something has to visit an authorisation URL once.
# The harness prints the URL, serves the loopback redirect itself, and then prints the
# refresh token to paste in here. After that every run is hands-free — no Android VM and
# no headless browser, for either the harness or the receiver.
SPOTIFY_REFRESH_TOKEN=
